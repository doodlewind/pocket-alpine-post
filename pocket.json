{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.lfkdsk.alpine-post",
  "name": "alpine-post",
  "title": "Alpine Post",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "data.fs",
        "input.pointer"
      ]
    }
  },
  "app": {
    "entry": "alpine-post.tsx",
    "output": "alpine-post",
    "framework": "solid",
    "companions": [
      "alpine-post"
    ],
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "integer-fit"
      }
    }
  }
}
